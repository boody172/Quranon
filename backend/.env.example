# ---- Quranon backend ----
APP_NAME=Quranon
APP_ENV=production
APP_KEY=                       # php artisan key:generate  (also encrypts saved payment keys — back it up)
APP_DEBUG=false                # never true in production
APP_URL=https://api.example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Where the app (frontend) is served: used for payment return links.
FRONTEND_URL=https://quranon.vercel.app
# Only these origins may call the API from a browser (comma separated).
CORS_ALLOWED_ORIGINS=https://quranon.vercel.app

# Dashboard: pick a non-obvious path, and optionally lock it to your own IPs.
ADMIN_PATH=admin
ADMIN_ALLOWED_IPS=
# IPs/CIDRs of your load balancer or proxy (leave empty if none).
TRUSTED_PROXIES=

# Translation files shared with the frontend (repo root /i18n).
I18N_PATH=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quranon
DB_USERNAME=quranon
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
